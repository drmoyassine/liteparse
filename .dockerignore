# Build context for `docker build -f apps/runner/Dockerfile .` — keep the
# uploaded context small; the Dockerfile COPYs exactly what each stage needs.
**/node_modules
**/dist
**/coverage

# Local model downloads (image fetches its own sha256-pinned copies; the
# committed JSON sidecars under models/moonshine ARE copied into the image)
apps/runner/models/rapidocr
apps/runner/models/moonshine/**/*.ort
apps/runner/models/moonshine/**/*.onnx

# Not part of any build stage
**/test
**/*.test.ts
.git
.gitignore
public
