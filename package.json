{
  "name": "liteparse",
  "version": "0.3.0",
  "description": "Isomorphic document text extraction (PDF, Office, images) with swappable raster/OCR/VLM adapters. Runs in the browser, Node, and Deno/edge.",
  "type": "module",
  "license": "MIT",
  "author": "drmoyassine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmoyassine/liteparse.git"
  },
  "homepage": "https://github.com/drmoyassine/liteparse#readme",
  "bugs": {
    "url": "https://github.com/drmoyassine/liteparse/issues"
  },
  "keywords": [
    "document",
    "extraction",
    "pdf",
    "docx",
    "xlsx",
    "ocr",
    "vision",
    "vlm",
    "isomorphic",
    "pdfjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./raster/sharp": {
      "types": "./dist/raster/sharp.d.ts",
      "import": "./dist/raster/sharp.js",
      "require": "./dist/raster/sharp.cjs"
    },
    "./ocr/rapidocr-server": {
      "types": "./dist/ocr/rapidocr-server.d.ts",
      "import": "./dist/ocr/rapidocr-server.js",
      "require": "./dist/ocr/rapidocr-server.cjs"
    },
    "./vlm/server": {
      "types": "./dist/vlm/server.d.ts",
      "import": "./dist/vlm/server.js",
      "require": "./dist/vlm/server.cjs"
    },
    "./stt/server": {
      "types": "./dist/stt/server.d.ts",
      "import": "./dist/stt/server.js",
      "require": "./dist/stt/server.cjs"
    },
    "./stt/moonshine-server": {
      "types": "./dist/stt/moonshine-server.d.ts",
      "import": "./dist/stt/moonshine-server.js",
      "require": "./dist/stt/moonshine-server.cjs"
    },
    "./engines/rapidocr": {
      "types": "./dist/engines/rapidocr.d.ts",
      "import": "./dist/engines/rapidocr.js",
      "require": "./dist/engines/rapidocr.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/copy-ort-wasm.mjs && node scripts/copy-pdfjs-worker.mjs"
  },
  "dependencies": {
    "dommatrix": "^1.0.3",
    "mammoth": "^1.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "onnxruntime-node": ">=1.20",
    "onnxruntime-web": ">=1.20",
    "pdfjs-dist": ">=4"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^22.7.0",
    "canvas": "^3.2.3",
    "fake-indexeddb": "^6.0.0",
    "jszip": "^3.10.1",
    "onnxruntime-node": "^1.27.0",
    "onnxruntime-web": "^1.27.0",
    "pdfjs-dist": "^4.8.0",
    "prettier": "^3.3.3",
    "sharp": "^0.34.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
